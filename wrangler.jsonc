{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wp2pc",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-14",
  "assets": {
    "directory": "./public/",
    "binding": "ASSETS",
    "run_worker_first": ["/health", "/ws*", "/api/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "PAIR_ROOMS",
        "class_name": "PairRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PairRoom"]
    }
  ],
  "r2_buckets": [
    {
      "binding": "BACKUPS",
      "bucket_name": "wp2pc-backups"
    }
  ],
  "observability": {
    "enabled": true
  }
}
